{
  "default_policy": { "in": "block", "out": "allow" },
  "rules": [
    { "action": "allow", "direction": "in",  "protocol": "tcp", "port": 22,  "comment": "SSH in" },
    { "action": "block", "direction": "out", "protocol": "tcp", "port": 23,  "comment": "no telnet out" },
